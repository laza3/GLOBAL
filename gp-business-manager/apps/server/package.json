{
  "name": "@gp/server",
  "version": "0.4.0",
  "private": true,
  "description": "GP Business Manager — serveur web (même cœur métier que l'application Windows, accessible depuis téléphone et ordinateur)",
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "node --disable-warning=ExperimentalWarning dist/server.cjs",
    "dev": "node scripts/build.mjs server && node dist/server.cjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "pack:local": "node scripts/pack-local.mjs",
    "e2e": "node scripts/build.mjs && playwright test"
  },
  "dependencies": {},
  "devDependencies": {
    "@gp/core": "^0.1.0",
    "@gp/shared": "^0.1.0",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/vite": "^4.3.5",
    "@vitejs/plugin-react": "^6.3.0",
    "@types/node": "^26.6.6",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
