<!doctype html>
<html lang="fr">
<head>
<meta charset="utf-8">
<title>AutoCare — étiquette {{ fmt.id }} {{ side }}</title>
<style>
@font-face { font-family: "AC Display"; src: url("{{ fonts }}/Archivo-ExpandedBold.ttf"); font-weight: 700; }
@font-face { font-family: "AC Display"; src: url("{{ fonts }}/Archivo-ExpandedSemiBold.ttf"); font-weight: 600; }
@font-face { font-family: "AC Text"; src: url("{{ fonts }}/Archivo-Regular.ttf"); font-weight: 400; }
@font-face { font-family: "AC Text"; src: url("{{ fonts }}/Archivo-Medium.ttf"); font-weight: 500; }
@font-face { font-family: "AC Text"; src: url("{{ fonts }}/Archivo-SemiBold.ttf"); font-weight: 600; }
@font-face { font-family: "AC Text"; src: url("{{ fonts }}/Archivo-Bold.ttf"); font-weight: 700; }

@page { size: {{ page_w }}mm {{ page_h }}mm; margin: 0; }
:root {
  --petrole: {{ c.petrole }}; --encre: {{ c.encre }}; --ecume: {{ c.ecume }};
  --brume: {{ c.brume }}; --lin: {{ c.lin }}; --gris: {{ c.gris }};
}
* { box-sizing: border-box; margin: 0; padding: 0; }
* { hyphenate-limit-chars: 7 3 3; }
html, body { width: {{ page_w }}mm; height: {{ page_h }}mm; background: #fff; }
body { position: relative; overflow: hidden; -webkit-print-color-adjust: exact; print-color-adjust: exact;
       font-family: "AC Text", sans-serif; color: var(--encre); font-kerning: normal;
       font-feature-settings: "kern" 1, "lnum" 1; text-rendering: geometricPrecision; }

/* zone fond perdu (trim + 3 mm) */
.bleedbox { position: absolute; left: {{ slug }}mm; top: {{ slug }}mm;
            width: {{ bleed_w }}mm; height: {{ bleed_h }}mm; overflow: hidden; }
/* maquette dessinée au format 1 L (100 × 130 mm), mise à l'échelle */
.art { position: absolute; left: {{ art_off }}mm; top: {{ art_off }}mm;
       width: 106mm; height: 136mm; transform-origin: 0 0; transform: scale({{ scale }}); }
.trim { position: absolute; left: 3mm; top: 3mm; width: 100mm; height: 130mm; }

.caps { font-family: "AC Display"; font-weight: 600; text-transform: uppercase; letter-spacing: .11em; }
.todo { background: #F1E3A6; box-shadow: 0 0 0 .4mm #F1E3A6; }

/* ---------- RECTO ---------- */
.front .paper { position: absolute; inset: 0; background: var(--ecume); }
.front .band  { position: absolute; left: 0; right: 0; top: 87mm; bottom: 0; background: var(--petrole); }
.front .head  { position: absolute; left: 7mm; right: 7mm; top: 7.5mm; display: flex;
                justify-content: space-between; align-items: flex-start; }
.front .head svg { height: 6mm; width: auto; display: block; fill: var(--encre); }
.front .ref   { font-size: 6.6pt; line-height: 1; color: var(--encre); padding-top: .9mm; }
.front .rule  { position: absolute; left: 7mm; right: 7mm; top: 18.5mm; height: 0; border-top: .25mm solid var(--encre); }
.front .name  { position: absolute; left: 7mm; right: 7mm; top: 33.5mm; }
.front h1     { font-family: "AC Display"; font-weight: 700; font-size: 29pt; line-height: .97;
                letter-spacing: -.012em; color: var(--encre); }
.front .tag   { margin-top: 5.2mm; font-weight: 600; font-size: 9.6pt; letter-spacing: .005em; color: var(--petrole); }
.front .pitch { margin-top: 1.6mm; font-size: 7.9pt; line-height: 1.34; color: var(--gris); max-width: 72mm; }

.front .bandin { position: absolute; left: 7mm; right: 7mm; top: 7mm; bottom: 6.5mm;
                 display: flex; flex-direction: column; justify-content: space-between; color: var(--ecume); }
.front .doses  { display: flex; flex-direction: column; }
.front .dose   { display: grid; grid-template-columns: 30mm 1fr auto; align-items: baseline; column-gap: 3mm;
                 padding: 2.1mm 0 2.2mm; border-top: .2mm solid rgba(183, 211, 203, .42); }
.front .dose:last-child { border-bottom: .2mm solid rgba(183, 211, 203, .42); }
.front .dose .m { font-weight: 500; font-size: 7.4pt; color: var(--brume); }
.front .dose .v { font-family: "AC Display"; font-weight: 700; font-size: 10.6pt; letter-spacing: -.005em; }
.front .dose .p { font-size: 6.8pt; color: var(--brume); text-align: right; }
.front .foot   { display: flex; justify-content: space-between; align-items: flex-end; }
.front .vol    { font-family: "AC Display"; font-weight: 700; font-size: 29pt; line-height: .74; letter-spacing: -.02em; }
.front .uses   { font-weight: 500; font-size: 6.9pt; color: var(--brume); padding-bottom: .1mm; }

/* ---------- VERSO ---------- */
.back .paper  { position: absolute; inset: 0; background: var(--ecume); }
.back .strip  { position: absolute; left: 0; right: 0; bottom: 0; height: 10.5mm; background: var(--petrole); }
.back .stripin{ position: absolute; left: 6.5mm; right: 6.5mm; bottom: 2.6mm; display: flex;
                justify-content: space-between; align-items: baseline; color: var(--ecume); }
.back .stripin .k { font-weight: 500; font-size: 6.6pt; color: var(--brume); }
.back .stripin .vol { font-family: "AC Display"; font-weight: 700; font-size: 9pt; }
.back .col    { position: absolute; left: 6.5mm; right: 6.5mm; top: 6.2mm; display: flex; flex-direction: column; }
.back .head   { display: flex; justify-content: space-between; align-items: flex-end; padding-bottom: 2.4mm;
                border-bottom: .3mm solid var(--encre); }
.back .head svg { height: 4.3mm; width: auto; display: block; fill: var(--encre); }
.back .head .t  { text-align: right; font-size: 6.6pt; line-height: 1.25; }
.back .head .t b { font-weight: 600; }
.back .head .t span { color: var(--gris); }
.back .desc   { margin-top: 2.7mm; font-size: 7.2pt; line-height: 1.33; text-wrap: pretty; hyphens: manual; }
.back .grid   { margin-top: 3.6mm; display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); column-gap: 5mm; }
.back h2      { font-size: 6.3pt; line-height: 1; color: var(--petrole); margin-bottom: 2.1mm; }
.back ol      { list-style: none; display: flex; flex-direction: column; gap: 1.6mm; }
.back ol li   { display: grid; grid-template-columns: 5.4mm 1fr; font-size: 6.9pt; line-height: 1.3; hyphens: auto; }
.back ol .n   { font-family: "AC Display"; font-weight: 700; font-size: 6.9pt; color: var(--petrole); }
.back ol b    { font-weight: 600; }
.back .doses  { border-top: .25mm solid var(--encre); margin-bottom: 3.6mm; }
.back .dose   { display: grid; grid-template-columns: 1fr auto; row-gap: .3mm; padding: 1.7mm 0 1.8mm;
                border-bottom: .2mm solid var(--gris); }
.back .dose .m { font-weight: 600; font-size: 6.9pt; }
.back .dose .v { font-family: "AC Display"; font-weight: 700; font-size: 8.6pt; color: var(--petrole);
                 grid-row: span 2; align-self: center; }
.back .dose .p { font-size: 6.6pt; color: var(--gris); }
.back ul      { list-style: none; display: flex; flex-direction: column; gap: 1.2mm; }
.back ul li   { display: grid; grid-template-columns: 2.6mm 1fr; font-size: 6.9pt; line-height: 1.3; hyphens: auto; }
.back ul li::before { content: "–"; color: var(--petrole); }
.back .legal  { margin-top: 3.4mm; padding-top: 2.5mm; border-top: .3mm solid var(--encre);
                display: flex; flex-direction: column; gap: 2.2mm; }
.back .legal p { font-size: 6.8pt; line-height: 1.3; hyphens: manual; text-wrap: pretty; }
.back .legal .lh { font-size: 6.3pt; color: var(--petrole); margin-right: 1.6mm; }
.back .id     { margin-top: 2.8mm; display: grid; grid-template-columns: minmax(0, 1fr) 21mm 21mm; column-gap: 2.4mm; align-items: stretch; }
.back .who    { font-size: 6.8pt; line-height: 1.3; align-self: center; }
.back .who b  { font-weight: 600; }
.back .box    { border: .25mm solid var(--gris); padding: 1mm 1.3mm; height: 8.6mm; font-size: 6pt; color: var(--gris); }

/* repères de coupe */
.marks { position: absolute; inset: 0; width: {{ page_w }}mm; height: {{ page_h }}mm; }
</style>
</head>
<body>
<div class="bleedbox">
 <div class="art {{ 'front' if side == 'recto' else 'back' }}">
  <div class="paper"></div>
{% if side == 'recto' %}
  <div class="band"></div>
  <div class="trim">
    <div class="head">
      <svg viewBox="{{ logo.vb }}" role="img" aria-label="AutoCare">{{ logo.body|safe }}</svg>
      <div class="ref caps">{{ t.reference|fr }}</div>
    </div>
    <div class="rule"></div>
    <div class="name">
      <h1>{{ t.produit_ligne1 }}<br>{{ t.produit_ligne2 }}</h1>
      <p class="tag">{{ t.accroche|fr }}</p>
      <p class="pitch">{{ t.promesse|fr }}</p>
    </div>
    <div class="band-zone" style="position:absolute;left:0;right:0;top:84mm;bottom:0">
      <div class="bandin">
        <div class="doses">
        {% for d in t.dosages %}
          <div class="dose"><span class="m">{{ d.mode|fr }}</span><span class="v">{{ d.valeur|fr }}</span><span class="p">{{ d.precision|fr }}</span></div>
        {% endfor %}
        </div>
        <div class="foot">
          <div class="vol">{{ fmt.volume|fr }}</div>
          <div class="uses">{{ t.usages|fr }}</div>
        </div>
      </div>
    </div>
  </div>
{% else %}
  <div class="strip"></div>
  <div class="trim">
    <div class="col">
      <div class="head">
        <svg viewBox="{{ logo.vb }}" role="img" aria-label="AutoCare">{{ logo.body|safe }}</svg>
        <div class="t"><b>{{ t.produit_ligne1 }} {{ t.produit_ligne2 }}</b><br><span>{{ t.accroche|fr }}</span></div>
      </div>
      <p class="desc">{{ t.description|fr|todo }}</p>
      <div class="grid">
        <section>
          <h2 class="caps">Mode d’emploi</h2>
          <ol>
          {% for e in t.etapes %}
            <li><span class="n">{{ '%02d' % loop.index }}</span><span>{{ e|fr|md }}</span></li>
          {% endfor %}
          </ol>
        </section>
        <section>
          <h2 class="caps">Dosage</h2>
          <div class="doses">
          {% for d in t.dosages %}
            <div class="dose"><span class="m">{{ d.mode|fr }}</span><span class="v">{{ d.valeur|fr }}</span><span class="p">{{ d.precision|fr }}</span></div>
          {% endfor %}
          </div>
          <h2 class="caps">Conseils</h2>
          <ul>
          {% for c in t.conseils %}<li><span>{{ c|fr }}</span></li>{% endfor %}
          </ul>
        </section>
      </div>
      <div class="legal">
        <p><span class="caps lh">Précautions</span>{{ t.precautions|fr|todo }}</p>
        <p><span class="caps lh">Composition</span>{{ t.composition|fr|todo }}</p>
      </div>
      <div class="id">
        <div class="who"><b>{{ t.fabricant|fr|todo }}</b><br>{{ t.adresse|fr|todo }}</div>
        <div class="box">N° de lot</div>
        <div class="box">Fabriqué le</div>
      </div>
    </div>
  </div>
  <div class="stripin" style="left:{{ 3 + 6.5 }}mm;right:{{ 3 + 6.5 }}mm;bottom:{{ 3 + 3.4 }}mm">
    <span class="k">{{ t.pied|fr }}</span>
    <span class="vol">{{ fmt.volume|fr }}</span>
  </div>
{% endif %}
 </div>
</div>
{% if marks %}
<svg class="marks" viewBox="0 0 {{ page_w }} {{ page_h }}" aria-hidden="true">
  <g stroke="#000" stroke-width="0.12" fill="none">
  {% for m in marks %}<line x1="{{ m[0] }}" y1="{{ m[1] }}" x2="{{ m[2] }}" y2="{{ m[3] }}"/>{% endfor %}
  </g>
  <text x="{{ slug }}" y="{{ slug - 4.2 }}" font-family="AC Text" font-size="2.2" fill="#000">AutoCare · étiquette {{ fmt.id }} · {{ side }} · {{ trim_w }} × {{ trim_h }} mm · fond perdu 3 mm</text>
</svg>
{% endif %}
</body>
</html>
