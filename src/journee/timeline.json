{
  "fps": 30,
  "duration": 80,
  "voiceFile": "journee/voix-off.mp3",
  "voice": [
    { "id": "A", "src": [0.0, 4.1], "at": 2.6, "text": "Parfois, il suffit de quelques secondes pour qu'une journée commence mal." },
    { "id": "B", "src": [4.4, 8.7], "at": 7.2, "text": "Tu te réveilles en retard, tu trébuches et tout semble déjà perdu." },
    { "id": "C", "src": [9.12, 10.65], "at": 13.0, "text": "Tu essaies de rattraper le temps." },
    { "id": "D", "src": [10.95, 12.25], "at": 14.9, "text": "Mais rien ne fonctionne." },
    { "id": "E", "src": [12.62, 15.65], "at": 16.5, "text": "Ton café se renverse, la pluie commence à tomber." },
    { "id": "F", "src": [15.95, 16.85], "at": 20.4, "text": "Et tu te demandes…" },
    { "id": "G", "src": [17.08, 18.85], "at": 21.7, "text": "pourquoi tout m'arrive à moi ?" },
    { "id": "H", "src": [19.3, 20.45], "at": 26.3, "text": "Tu rates ton bus." },
    { "id": "I", "src": [20.8, 26.75], "at": 29.6, "text": "Tu t'assois, épuisé, avec cette impression que quoi que tu fasses, rien ne va dans ton sens." },
    { "id": "J", "src": [27.47, 31.8], "at": 38.2, "text": "Mais au milieu de cette mauvaise journée, tu remarques quelqu'un qui a besoin d'aide." },
    { "id": "K", "src": [32.2, 34.3], "at": 43.1, "text": "Tu pourrais simplement continuer ton chemin." },
    { "id": "L", "src": [34.62, 36.2], "at": 45.7, "text": "Mais tu décides de t'arrêter." },
    { "id": "M", "src": [36.6, 38.4], "at": 48.6, "text": "Tu l'aides à ramasser ses affaires." },
    { "id": "N", "src": [38.88, 42.0], "at": 52.0, "text": "En retour, il te tend son parapluie avec un sourire." },
    { "id": "O", "src": [42.42, 43.12], "at": 55.9, "text": "Et soudain…" },
    { "id": "P", "src": [43.35, 44.72], "at": 56.95, "text": "quelque chose change." },
    { "id": "Q", "src": [45.17, 49.07], "at": 60.2, "text": "Tu avais passé toute la journée à attendre qu'il t'arrive quelque chose de bien." },
    { "id": "R", "src": [49.46, 51.63], "at": 64.7, "text": "Mais tu as fini par comprendre une chose." },
    { "id": "S", "src": [52.09, 55.1], "at": 67.5, "text": "Parfois, le bonheur ne vient pas de ce qui nous arrive." },
    { "id": "T", "src": [55.37, 58.62], "at": 71.1, "text": "Il vient de ce que nous choisissons de faire malgré tout." },
    { "id": "U", "src": [59.05, 62.51], "at": 75.0, "text": "Une mauvaise journée n'est pas forcément une journée inutile." }
  ],
