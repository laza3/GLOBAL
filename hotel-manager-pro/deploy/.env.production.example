# Copier en .env à la racine (jamais versionné) et remplacer chaque CHANGEZ-MOI.
# Générer les secrets :  openssl rand -base64 48  /  openssl rand -base64 32
PUBLIC_URL=https://hotel.exemple.mg
DB_ADMIN_PASSWORD=CHANGEZ-MOI
APP_DB_PASSWORD=CHANGEZ-MOI
PLATFORM_DB_PASSWORD=CHANGEZ-MOI
CSRF_SECRET=CHANGEZ-MOI
# Perdre cette clé rend illisibles les numéros de pièces d'identité : la sauvegarder SÉPARÉMENT de la base.
ENCRYPTION_KEY=CHANGEZ-MOI
WEB_PORT=8080
