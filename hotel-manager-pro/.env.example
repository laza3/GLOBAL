# Compte d'administration : migrations uniquement (jamais utilisé par l'API en fonctionnement)
DATABASE_ADMIN_URL=postgres://hmp_dev:hmp_dev@127.0.0.1:5432/hmp_dev

# Pools de l'API (production) : un rôle par pool. Mots de passe à générer (voir docs/security-model.md).
DATABASE_URL_APP=postgres://hmp_app:CHANGEZ-MOI@127.0.0.1:5432/hmp_dev
DATABASE_URL_PLATFORM=postgres://hmp_platform:CHANGEZ-MOI@127.0.0.1:5432/hmp_dev

# Tests (base modèle clonée par fichier de test)
HMP_TEST_ADMIN_URL=postgres://hmp_dev:hmp_dev@127.0.0.1:5432/postgres

# API (apps/api) — voir docs/api.md
NODE_ENV=development
# Environnement : development en local. staging / production exigent NODE_ENV=production (voir docs/environnements.md)
APP_ENV=development
HOST=127.0.0.1
PORT=3000
# Origines autorisées à appeler l'API avec des cookies (interface web), séparées par des virgules
ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
# Secret de signature des jetons CSRF : 32 caractères aléatoires MINIMUM, jamais versionné.
#   openssl rand -base64 48
CSRF_SECRET=CHANGEZ-MOI-chaine-aleatoire-de-48-caracteres-minimum
# Chiffrement des pièces d'identité (OBLIGATOIRE en production) : openssl rand -base64 32
# ENCRYPTION_KEY=
SESSION_TTL_HOURS=12
PLATFORM_SESSION_TTL_HOURS=8
# Limites par minute et par adresse IP
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=10
PLATFORM_AUTH_RATE_LIMIT_MAX=5
# À activer derrière un proxy de confiance (pour voir l'adresse IP réelle)
TRUST_PROXY=false
# Cookies « Secure » : forcé en production (la configuration refuse de démarrer sans)
COOKIE_SECURE=false
LOG_LEVEL=info
